(1, 'Mystery Quest', 'mystery-quest', '<p><span data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiZU1ZNnpzSHZwdjFuanR0WEVnYzk2ciIsInBhc3RlSUQiOjE5ODQ4NjQwOTIsImRhdGFUeXBlIjoic2NlbmUiLCJlbnZpcm9ubWVudCI6Ind3dy5maWdtYS5jb20iLCJzZWxlY3RlZE5vZGVEYXRhIjoiMzM4OTo5Mjh8MzF8MCJ9Cg==(/figmeta)--&gt;\"></span><span data-buffer=\"&lt;!--(figma)(/figma)--&gt;\"></span><span style=\"white-space: pre-wrap;\">A story-driven team challenge where employees collaborate, question, and compete to solve the case..\r\n</span></p><ul role=\"list\"><li style=\"white-space: pre-wrap;\">Role-based activity (Investigator, Culprit, Witness, and more)</li><li style=\"white-space: pre-wrap;\"> Real-time questioning and deduction Tetst</li><li style=\"white-space: pre-wrap;\"> Time-bound challenges to maintain urgency</li><li style=\"white-space: pre-wrap;\"> Built for communication and strategic thinking</li></ul><p><span style=\"white-space: pre-wrap;\"></span></p><p><span style=\"white-space: pre-wrap;\">Builds stronger communication, sharper thinking, and real team collaboration in a high-energy environment.</span></p>', 'activities/TEOZeXmAJdCAs1KKU5r9c2hiXPctabJCo0X0yLea.jpg', 'activities/icons/kS2vRdgOZo4Yc8uD87fYHXb1TU7dFdrY8bSVKz4s.png', 'active', 120, 5, 300, 300, 120, 600, 120, 5, 5, 5, 100, 50, 20, -10, 10, 10, 10, 60, 10, -10, 50, -20, 100, 10, 5, -20, -30, 80, 10, -15, 1, 3, 420, 30, '2026-05-26 12:29:06', '2026-10-02 17:49:52');
INSERT INTO `activities` (`id`, `title`, `slug`, `description`, `cover_image`, `icon`, `status`, `lobby_wait_secs`, `entry_cutoff_mins`, `game_duration_secs`, `case_summary_view_secs`, `strategy_guide_delay_secs`, `clue_room_unlock_secs`, `question_response_secs`, `max_questions`, `group_size`, `auto_expire_days`, `win_bonus`, `participation_bonus`, `timely_response_bonus`, `no_response_penalty`, `final_accusation_bonus`, `clue_room_bonus`, `cooperation_bonus`, `role_goal_bonus`, `witness_passcard_bonus`, `role_wrong_penalty`, `role_correct_bonus`, `culprit_caught_penalty`, `culprit_win_bonus`, `lie_detector_participation_bonus`, `lie_detector_init_bonus`, `investigator_no_accusation_penalty`, `investigator_wrong_penalty`, `investigator_correct_bonus`, `investigator_question_bonus`, `wrong_vote_penalty`, `lie_detector_enabled`, `lie_detector_max_questions`, `lie_detector_timer_secs`, `lie_detector_voting_timer_secs`, `created_at`, `updated_at`) VALUES
(2, 'Cook & Create', 'cook-and-creates', 'A fun cooking-themed impostor game where players collaborate to create the best dish while finding the hidden impostor among them!', 'activities/n3usT15oXiq8EqxdOr7QodV5yLkTsZI258AITCZr.png', 'activities/icons/12d6TowOlOVTqwPiSpdEHG5PN02Bzz50ebXLBDdK.png', 'draft', 900, 15, 1500, 300, 120, 600, 120, 5, 5, 5, 100, 50, 20, -10, 10, 10, 10, 60, 10, -10, 50, -20, 100, 10, 5, -20, -30, 80, 10, -15, 1, 3, 420, 30, '2026-05-31 16:09:58', '2026-08-07 18:10:40'),
(112, 'Cook & Create', 'cook-create', '<p><span data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiZU1ZNnpzSHZwdjFuanR0WEVnYzk2ciIsInBhc3RlSUQiOjgzODgyMTcxLCJkYXRhVHlwZSI6InNjZW5lIiwiZWRpdG9yVHlwZSI6ImRlc2lnbiIsImVudmlyb25tZW50Ijoid3d3LmZpZ21hLmNvbSIsInNlbGVjdGVkTm9kZURhdGEiOiIzMzkyOjEwMTR8MzF8MCJ9Cg==(/figmeta)--&gt;\"></span></p><p><span style=\"white-space: pre-wrap;\">A fast-paced creative challenge where teams collaborate to build something unique under constraints. testing\r\n</span><span style=\"white-space: pre-wrap; font-family: &quot;Source Sans Pro&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;; font-size: 1rem;\">      </span></p><ul role=\"list\"><li style=\"white-space: pre-wrap;\"><span style=\"white-space: normal\">Secret ingredient-based activity test</span></li><li style=\"white-space: pre-wrap;\"><span style=\"white-space: normal\"><span style=\"white-space: pre-wrap;\">Step-by-step collaborative creation</span></span></li><li style=\"\">Limited actions per player for balanced participation A</li><li style=\"\">Fun, unpredictable, and creative outcomes B<br><br></li></ul><p><span style=\"white-space: pre-wrap;\"></span></p><p><span style=\"white-space-collapse: preserve;\">Encourages creativity, quick thinking, and seamless team coordination in a playful setting.</span></p>', 'activities/n3usT15oXiq8EqxdOr7QodV5yLkTsZI258AITCZr.png', 'activities/icons/12d6TowOlOVTqwPiSpdEHG5PN02Bzz50ebXLBDdK.png', 'active', 900, 15, 1500, 0, 0, 0, 120, 0, 5, 5, 100, 50, 20, -10, 10, 10, 10, 60, 10, -10, 50, -20, 100, 10, 5, -20, -30, 80, 10, -15, 0, 0, 0, 0, '2026-08-05 15:35:36', '2026-09-12 13:35:24'),
(113, 'Cook & Create', 'cook-and-create', 'A fun cooking-themed impostor game where players collaborate to create the best dish while finding the hidden impostor among them!', NULL, '🍳', 'draft', 900, 15, 1500, 0, 0, 0, 120, 0, 5, 5, 100, 50, 20, -10, 10, 10, 10, 60, 10, -10, 50, -20, 100, 10, 5, -20, -30, 80, 10, -15, 0, 0, 0, 0, '2026-08-08 15:05:37', '2026-08-09 11:05:56');

