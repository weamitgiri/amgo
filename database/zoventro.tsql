INSERT INTO `activity_games` (`id`, `activity_id`, `title`, `case_summary`, `timeline`, `quick_facts`, `tagline`, `bg_image`, `status`, `created_at`, `updated_at`, `victim_name`, `culprit_image`) VALUES
(1, 1, 'The Raghav Malhotra Case', '<h3>Case Plot</h3><p class=\"MsoNormal\">An old wealthy businessman, Raghav Malhotra, is found dead\r\nin his luxury bungalow. On the night of his greatest triumph — the approval\r\ncelebration for his ambitious Dream City Project. <br>\r\nThe project, a large-scale real estate development, was built on land acquired\r\nfrom local farming communities under disputed and allegedly forced conditions. <br>\r\nThe party was in full swing. <o:p></o:p></p><p class=\"MsoNormal\">Guests, business associates, and family were present. But\r\nbehind the celebrations, tensions ran deep. <o:p></o:p></p><p>\r\n\r\n\r\n\r\n</p><p class=\"MsoNormal\">Medical examination estimates the time of death at approximately 11:30 PM. The cause of death was a fatal stab wound.<o:p></o:p></p>', '[{\"time\": \"10:00 PM\", \"event\": \"Party begins at the Bungalow — guests, associates, media arrive\"}, {\"time\": \"10:30 PM\", \"event\": \"Raghav Malhotra gives victory speech celebrating Dream City Project approval\"}, {\"time\": \"10:45 PM\", \"event\": \"Guest dancing and enjoying with loud music, dinner\"}, {\"time\": \"11:00 PM\", \"event\": \"Farmer’s leader Kartar Sah arrives uninvited and starts shouting in party\"}, {\"time\": \"11:10 PM\", \"event\": \"Raghav Malhotra asks him to come to his private room to discuss peacefully while guests can continue enjoying the party\"}, {\"time\": \"11:20 PM\", \"event\": \"Raghav calls his son Vikram — call lasts 4 minutes (last call on his phone)\"}, {\"time\": \"11:30 PM\", \"event\": \"Kartar Sah  exits study, leaves bungalow — confirmed by gate guard. Estimated time of death\"}, {\"time\": \"11:50 PM\", \"event\": \"Raju enters with tea — finds dead body. Raju informs police.\"}]', '{\"weather\": \"Rainy\", \"location\": \"Malhotra Bungalow, Mumbai\", \"date_time\": \"26th May, 10.00 PM to 12 PM\", \"cctv_status\": \"Operational (Limited Coverage)\"}', 'Uncover the truth. Catch the hidden culprit (Murderer)', 'games/y6VxkwPtx8GyS5CzoQRAszMgSWYVeTdGwaKq2AAL.jpg', 'active', '2026-05-26 12:29:06', '2026-10-04 04:38:30', 'Raghav Malhotra', 'culprit/ealjaAaew80FjfNxT0PhHfhzsJeMowhRfseCTQC2.jpg'),
(5, 1, 'The File Holl Secret', '<h3>Case Plot</h3><p>An old wealthy businessman, Raghav Malhotra, is found dead in his luxury bungalow on the night of his greatest triumph — the approval celebration for his ambitious Dream City Project.</p><p>The project, a large-scale real estate development, was built on land acquired from local farming communities under disputed and allegedly forced conditions.</p><p>The party was in full swing. Guests, business associates, and family were present. But behind the celebrations, tensions ran deep.</p><p>Medical estimation places time of death at approximately 11:30 PM.</p><p>Businessman was found dead in the room.</p>', '[{\"time\": \"10:00 PM\", \"event\": \"Party begins at the Bungalow — guests, associates, media arrive\"}, {\"time\": \"10:30 PM\", \"event\": \"Raghav Malhotra gives victory speech celebrating Dream City Project approval\"}, {\"time\": \"10:45 PM\", \"event\": \"Guest dancing and enjoying with loud music, dinner\"}, {\"time\": \"11:00 PM\", \"event\": \"Farmer’s leader Kartar Sah arrives uninvited and starts shouting in party\"}, {\"time\": \"11:10 PM\", \"event\": \"Raghav Malhotra asks him to come to his private room to discuss peacefully\"}, {\"time\": \"11:20 PM\", \"event\": \"Raghav calls his son Vikram — call lasts 4 minutes (last call on his phone)\"}, {\"time\": \"11:30 PM\", \"event\": \"Kartar Sah exits study, leaves bungalow — confirmed by gate guard.\"}, {\"time\": \"11:50 PM\", \"event\": \"Raju enters with tea — finds dead body. Raju informs police.\"}]', '{\"weather\": \"Clear Night\", \"location\": \"Luxury Bungalow, Mumbai\", \"date_time\": \"26th May, 11:30 PM (Est. Death)\", \"cctv_status\": \"Operational (Limited Coverage)\"}', 'Not everything is as it seems in the Willow Bungalow.', 'games/eM6WZJ3L1JSQx4hm6U3lmdp0QonxFyQoChjQv24j.png', 'active', '2026-06-05 15:35:05', '2026-09-12 18:12:00', NULL, NULL),
(6, 1, 'The College Hostel', '<h3>Case Plot</h3><p>An old wealthy businessman, Raghav Malhotra, is found dead in his luxury bungalow on the night of his greatest triumph — the approval celebration for his ambitious Dream City Project.</p><p>The project, a large-scale real estate development, was built on land acquired from local farming communities under disputed and allegedly forced conditions.</p><p>The party was in full swing. Guests, business associates, and family were present. But behind the celebrations, tensions ran deep.</p><p>Medical estimation places time of death at approximately 11:30 PM.</p><p>Businessman was found dead in the room.</p>', '[{\"time\": \"10:00 PM\", \"event\": \"Party begins at the Bungalow — guests, associates, media arrive\"}, {\"time\": \"10:30 PM\", \"event\": \"Raghav Malhotra gives victory speech celebrating Dream City Project approval\"}, {\"time\": \"10:45 PM\", \"event\": \"Guest dancing and enjoying with loud music, dinner\"}, {\"time\": \"11:00 PM\", \"event\": \"Farmer’s leader Kartar Sah arrives uninvited and starts shouting in party\"}, {\"time\": \"11:10 PM\", \"event\": \"Raghav Malhotra asks him to come to his private room to discuss peacefully\"}, {\"time\": \"11:20 PM\", \"event\": \"Raghav calls his son Vikram — call lasts 4 minutes (last call on his phone)\"}, {\"time\": \"11:30 PM\", \"event\": \"Kartar Sah exits study, leaves bungalow — confirmed by gate guard.\"}, {\"time\": \"11:50 PM\", \"event\": \"Raju enters with tea — finds dead body. Raju informs police.\"}]', '{\"weather\": \"Clear Night\", \"location\": \"Luxury Bungalow, Mumbai\", \"date_time\": \"26th May, 11:30 PM (Est. Death)\", \"cctv_status\": \"Operational (Limited Coverage)\"}', 'Not everything is as it seems in the Willow Bungalow.', NULL, 'active', '2026-06-05 15:35:40', '2026-06-05 15:36:31', NULL, NULL),
(7, 1, 'The School Scame', '<h3>Case Plot</h3><p>An old wealthy businessman, Raghav Malhotra, is found dead in his luxury bungalow on the night of his greatest triumph — the approval celebration for his ambitious Dream City Project.</p><p>The project, a large-scale real estate development, was built on land acquired from local farming communities under disputed and allegedly forced conditions.</p><p>The party was in full swing. Guests, business associates, and family were present. But behind the celebrations, tensions ran deep.</p><p>Medical estimation places time of death at approximately 11:30 PM.</p><p>Businessman was found dead in the room.</p>', '[{\"time\": \"10:00 PM\", \"event\": \"Party begins at the Bungalow — guests, associates, media arrive\"}, {\"time\": \"10:30 PM\", \"event\": \"Raghav Malhotra gives victory speech celebrating Dream City Project approval\"}, {\"time\": \"10:45 PM\", \"event\": \"Guest dancing and enjoying with loud music, dinner\"}, {\"time\": \"11:00 PM\", \"event\": \"Farmer’s leader Kartar Sah arrives uninvited and starts shouting in party\"}, {\"time\": \"11:10 PM\", \"event\": \"Raghav Malhotra asks him to come to his private room to discuss peacefully\"}, {\"time\": \"11:20 PM\", \"event\": \"Raghav calls his son Vikram — call lasts 4 minutes (last call on his phone)\"}, {\"time\": \"11:30 PM\", \"event\": \"Kartar Sah exits study, leaves bungalow — confirmed by gate guard.\"}, {\"time\": \"11:50 PM\", \"event\": \"Raju enters with tea — finds dead body. Raju informs police.\"}]', '{\"weather\": \"Clear Night\", \"location\": \"Luxury Bungalow, Mumbai\", \"date_time\": \"26th May, 11:30 PM (Est. Death)\", \"cctv_status\": \"Operational (Limited Coverage)\"}', 'Not everything is as it seems in the Willow Bungalow.', NULL, 'active', '2026-06-05 15:35:55', '2026-06-11 15:28:36', NULL, NULL),
(8, 112, 'Kitchen Chaos', '<h3>Game Brief</h3><p>Welcome to the chaotic kitchen of MasterChef Impostor! Your team has 25 minutes to create the best dish you can imagine. But beware — one of you is the Hidden Impostor whose only goal is to mislead the group into creating the worst dish possible!</p><p>Round 1: Vote for the best ingredients (top 4 selected)!<br/>Round 2: Each of you submits one cooking step, then the group votes to keep or remove each step!<br/>Round 3: 60-second group chat, then vote to eliminate who you think the impostor is!</p>', NULL, NULL, 'Create the perfect dish… while rooting out the impostor.', NULL, 'active', '2026-08-07 17:50:16', '2026-08-07 17:50:16', NULL, NULL),
(9, 113, 'Kitchen Chaos', '<h3>Game Brief</h3><p>Welcome to the chaotic kitchen of MasterChef Impostor! Your team has 25 minutes to create the best dish you can imagine. But beware — one of you is the Hidden Impostor whose only goal is to mislead the group into creating the worst dish possible!</p><p>Round 1: Vote for the best ingredients (top 4 selected)!<br/>Round 2: Each of you submits one cooking step, then the group votes to keep or remove each step!<br/>Round 3: 60-second group chat, then vote to eliminate who you think the impostor is!</p>', NULL, NULL, 'Create the perfect dish… while rooting out the impostor.', NULL, 'active', '2026-08-08 15:05:37', '2026-08-08 15:05:37', NULL, NULL);

