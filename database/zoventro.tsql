(22, 7, 'The Study Evidence', 'Forensic investigators have marked key evidence found at the crime scene.', 'White circles indicate areas of interest. What they mean — is for you to determine.', 'clues/16smOc0HgtDnSYahsBgcFhtrYxEWD0UcD3bA2Us2.jpg', '2026-06-11 15:28:36', '2026-06-11 15:28:36'),
(31, 5, 'The Study Evidence', 'Forensic investigators have marked key evidence found at the crime scene.', 'White circles indicate areas of interest. What they mean — is for you to determine.', 'clues/16smOc0HgtDnSYahsBgcFhtrYxEWD0UcD3bA2Us2.jpg', '2026-09-12 18:12:00', '2026-09-12 18:12:00'),
(55, 1, 'The Evidence', 'Forensic investigators have marked key evidence found at the crime scene.', 'Every murder has a motive.\r\nFind who benefited from Raghav’s death — then eliminate the rest.', 'clues/jYIVLyYgHVailaBPqRvNUgaSYa033Rj1kp0b8e8R.jpg', '2026-10-04 04:38:30', '2026-10-04 04:38:30');

