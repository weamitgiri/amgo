CREATE TABLE `investigator_cards` (
  `id` bigint UNSIGNED NOT NULL,
  `game_id` bigint UNSIGNED NOT NULL,
  `card_number` tinyint UNSIGNED NOT NULL,
  `suspect_label` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
  `tag` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `profile_text` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `why_suspicious` json DEFAULT NULL,
  `suggested_questions` json DEFAULT NULL,
  `appears_at_secs` int UNSIGNED NOT NULL,
  `closes_at_secs` int UNSIGNED NOT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

--
-- Dumping data for table `investigator_cards`
--

INSERT INTO `investigator_cards` (`id`, `game_id`, `card_number`, `suspect_label`, `tag`, `profile_text`, `why_suspicious`, `suggested_questions`, `appears_at_secs`, `closes_at_secs`, `created_at`, `updated_at`) VALUES
(73, 6, 1, 'Suspect 1: Kartar Sah', 'Farmer Leader — Uninvited Guest', 'Kartar Sah was the last known person inside the study with Raghav Malhotra. He left at exactly 11:30 PM — the estimated time of death. He had the loudest, most public motive — two years of protests, legal battles, and public threats against Raghav. Land registry papers with his name were found scattered across the study floor.', NULL, NULL, 5, 35, '2026-06-05 15:36:31', '2026-06-05 15:36:31'),
(74, 6, 2, 'Suspect 2: Vikram Malhotra', 'The Heir', 'Vikram Malhotra is the only son of Raghav Malhotra and the sole heir. At 11:20 PM — 10 minutes before the death — Raghav called Vikram. The call lasted 4 minutes. It was the last call ever made from Raghav\'s phone.', NULL, NULL, 155, 185, '2026-06-05 15:36:31', '2026-06-05 15:36:31'),
(75, 6, 3, 'Suspect 3: Raju', 'The Servant', 'Raju has worked in the bungalow for 11 years. He knows every private corridor. Kitchen log shows the kettle was boiled at 11:20 PM — unusually early. He is the only staff member who knew Kartar Sah personally.', NULL, NULL, 305, 335, '2026-06-05 15:36:31', '2026-06-05 15:36:31'),
(76, 6, 4, 'Suspect 4: Priya Malhotra', 'The Daughter-in-law', 'Priya Malhotra claims she was socialising near the dining area. However, no guest can confirm her exact location between 11:25 PM and 11:45 PM. She was seen near the kitchen at 11:15 PM.', NULL, NULL, 455, 485, '2026-06-05 15:36:31', '2026-06-05 15:36:31'),
(85, 7, 1, 'Suspect 1: Kartar Sah', 'Farmer Leader — Uninvited Guest', 'Kartar Sah was the last known person inside the study with Raghav Malhotra. He left at exactly 11:30 PM — the estimated time of death. He had the loudest, most public motive — two years of protests, legal battles, and public threats against Raghav. Land registry papers with his name were found scattered across the study floor.', NULL, NULL, 5, 35, '2026-06-11 15:28:36', '2026-06-11 15:28:36'),
(86, 7, 2, 'Suspect 2: Vikram Malhotra', 'The Heir', 'Vikram Malhotra is the only son of Raghav Malhotra and the sole heir. At 11:20 PM — 10 minutes before the death — Raghav called Vikram. The call lasted 4 minutes. It was the last call ever made from Raghav\'s phone.', NULL, NULL, 155, 185, '2026-06-11 15:28:36', '2026-06-11 15:28:36'),
(87, 7, 3, 'Suspect 3: Raju', 'The Servant', 'Raju has worked in the bungalow for 11 years. He knows every private corridor. Kitchen log shows the kettle was boiled at 11:20 PM — unusually early. He is the only staff member who knew Kartar Sah personally.', NULL, NULL, 305, 335, '2026-06-11 15:28:36', '2026-06-11 15:28:36'),
(88, 7, 4, 'Suspect 4: Priya Malhotra', 'The Daughter-in-law', 'Priya Malhotra claims she was socialising near the dining area. However, no guest can confirm her exact location between 11:25 PM and 11:45 PM. She was seen near the kitchen at 11:15 PM.', NULL, NULL, 455, 485, '2026-06-11 15:28:36', '2026-06-11 15:28:36'),
(121, 5, 1, 'Suspect 1: Kartar Sah', 'Farmer Leader — Uninvited Guest', 'Kartar Sah was the last known person inside the study with Raghav Malhotra. He left at exactly 11:30 PM — the estimated time of death. He had the loudest, most public motive — two years of protests, legal battles, and public threats against Raghav. Land registry papers with his name were found scattered across the study floor.', NULL, NULL, 5, 35, '2026-09-12 18:12:00', '2026-09-12 18:12:00'),
(122, 5, 2, 'Suspect 2: Vikram Malhotra', 'The Heir', 'Vikram Malhotra is the only son of Raghav Malhotra and the sole heir. At 11:20 PM — 10 minutes before the death — Raghav called Vikram. The call lasted 4 minutes. It was the last call ever made from Raghav\'s phone.', NULL, NULL, 155, 185, '2026-09-12 18:12:00', '2026-09-12 18:12:00'),
(123, 5, 3, 'Suspect 3: Raju', 'The Servant', 'Raju has worked in the bungalow for 11 years. He knows every private corridor. Kitchen log shows the kettle was boiled at 11:20 PM — unusually early. He is the only staff member who knew Kartar Sah personally.', NULL, NULL, 305, 335, '2026-09-12 18:12:00', '2026-09-12 18:12:00'),
(124, 5, 4, 'Suspect 4: Priya Malhotra', 'The Daughter-in-law', 'Priya Malhotra claims she was socialising near the dining area. However, no guest can confirm her exact location between 11:25 PM and 11:45 PM. She was seen near the kitchen at 11:15 PM.', NULL, NULL, 455, 485, '2026-09-12 18:12:00', '2026-09-12 18:12:00'),
(217, 1, 1, 'Suspect 1: Kartar Sah', 'Farmer Leader — Uninvited Guest', 'Kartar Sah was the last known person inside the study with Raghav Malhotra. He left at exactly 11:30 PM — the estimated time of death. He had the loudest, most public motive — two years of protests, legal battles, and public threats against Raghav. Land registry papers with his name were found scattered across the study floor.<br />\r\n<br />\r\nWhy he looks suspicious:<br />\r\n•	Exited the bungalow at the exact estimated time of death<br />\r\n•	Had an active, well-documented grudge against the victim<br />\r\n•	His name appears on land papers found scattered at the crime scene<br />\r\n<br />\r\nSuggested questions:<br />\r\n1.	\"You were the last person seen with him. What exactly was said in that room?\"<br />\r\n2.	\"The land papers with your name — did you bring them or were they already there?\"<br />\r\n3.	\"You have publicly threatened Raghav Malhotra before. Did you mean it?\"', NULL, NULL, 5, 35, '2026-10-04 04:38:30', '2026-10-04 04:38:30'),
(218, 1, 2, 'Suspect 2: Vikram Malhotra', 'The Heir', 'Vikram Malhotra is the only son of Raghav Malhotra and the sole heir to one of the most valuable private estates. Everything Raghav owned was destined for Vikram. <br />\r\nAt 11:20 PM — exactly 10 minutes before the estimated time of death — Raghav called Vikram. The call lasted 4 minutes. It was the last call ever made from Raghav\'s phone. <br />\r\n<br />\r\nWhy he looks suspicious:<br />\r\n•	Sole heir to the Malhotra estate <br />\r\n•	Received the last call from the victim exactly 10 minutes before time of death<br />\r\n•	Whereabouts between 11:24 PM and 11:40 PM are based solely on his own account — no witness can confirm his location during this window<br />\r\n<br />\r\nSuggested questions:<br />\r\n1.	\"You are your father\'s only heir — everything he built was coming to you. Did you know any specific reason someone would want him dead? Do you have any name in mind?\"<br />\r\n2.	\"After the call ended, where did you go? One staff member places you near the east corridor at 11:26 PM. Explain that.', NULL, NULL, 65, 100, '2026-10-04 04:38:30', '2026-10-04 04:38:30'),
(219, 1, 3, 'Suspect 3: Raju', 'The Servant', 'Raju has worked in the Malhotra bungalow for 11 years. He knows every room, every corridor, every bolt and latch — including the private connecting corridor between the bedroom wing and the study. He claims he was in the kitchen from 11:20 PM preparing tea. But the kitchen log shows the kettle was boiled at 11:20 PM — unusually early for tea only supposed to be served at 11:50 PM. He is the only staff member who knew Kartar Sah(farmer) personally — both come from the same farming district. He discovered the body — and he was remarkably calm.<br />\r\n<br />\r\nWhy he looks suspicious:<br />\r\n•	Boiled the kettle 30 minutes before tea was needed <br />\r\n•	Personally knew Kartar Sah — possible coordination between the two<br />\r\n•	Only staff member with full knowledge of every access point including the private corridor<br />\r\n<br />\r\nSuggested questions:<br />\r\n1.	\"You prepared tea 30 minutes early. Why?\"<br />\r\n2.	\"You and Kartar Sah are from the same district. Did you speak to him that evening?\"', NULL, NULL, 150, 190, '2026-10-04 04:38:30', '2026-10-04 04:38:30'),
(220, 1, 4, 'Suspect 4: Priya Malhotra', 'The Daughter-in-law', 'Priya Malhotra, Vikram\'s wife, was present at the party all evening and claims she was socialising at the dining area between 11:15 PM and 11:45 PM. However, no guest can confirm her exact location between 11:25 PM and 11:45 PM. <br />\r\n<br />\r\nWhy she looks suspicious:<br />\r\n•	Location completely unaccounted for during the critical 15-minute window.<br />\r\n•	Was seen near the kitchen at 11:15 PM — minutes before the critical window <br />\r\n•	 Was notably composed when the body was discovered <br />\r\n•	She was one of the few people who knew the layout of the private study<br />\r\n<br />\r\nSuggested questions:<br />\r\n1.	\"Where exactly were you between 11:25 PM and 11:45 PM? Name one person who can confirm that.\"<br />\r\n2.	\"You were seen near the kitchen at 11:15 PM. What were you doing there?\"', NULL, NULL, 250, 320, '2026-10-04 04:38:30', '2026-10-04 04:38:30');

